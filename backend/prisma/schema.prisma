generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- LES TABLES ---

// 1. Table Utilisateurs (Étudiants et Instructeurs)
model User {
  id        Int      @id @default(autoincrement())
  name      String   
  firstName String?  
  lastName  String?  
  birthDate String?  
  phone     String?  
  avatarUrl String?  @db.Text
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  status    String   @default("APPROVED") // APPROVED, PENDING, REJECTED
  sector    String? 

  isEmailVerified   Boolean @default(false)
  verificationToken String?
  createdAt DateTime @default(now())
  coursesCreated Course[]     @relation("InstructorCourses")
  enrollments    Enrollment[]
  lessonProgresses LessonProgress[]
}

// Les différents rôles possibles
enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

// 2. Table Formations (Courses)
model Course {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  price       Float    @default(0.0) // 0 si c'est gratuit
  accessKey   String   @default("EDUTEST")

  // Le lien de l'image de couverture
  imageUrl    String?  @default("https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=800&auto=format&fit=crop") 
  passingScore Float @default(70.0)
  timeLimitDays Int? @default(30)
  level       String   @default("Débutant") // "Débutant", "Intermédiaire" ou "Avancé"
  
  createdAt   DateTime @default(now())

  // Relation avec le créateur (Instructeur)
  instructorId Int
  instructor   User         @relation("InstructorCourses", fields: [instructorId], references: [id])

  // Contenu du cours
  lessons      Lesson[]
  enrollments  Enrollment[]

  examQuestions Question[]   @relation("CourseExam")

  // Relation avec la Branche (Catégorie)
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])
}

// 3. Table Leçons (Vidéos et contenu)
model Lesson {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?  @db.Text // Description texte de la leçon
  videoUrl  String?  // Lien de la vidéo
  pdfUrl    String? 
  order     Int      @default(0) // L'ordre de la leçon dans la formation

  quizQuestionCount Int @default(0)
  // Relation avec la formation
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progresses       LessonProgress[]

  questions  Question[] @relation("LessonQuiz")
}

// 4. Table des inscriptions (Qui achète/suit quelle formation)
model Enrollment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  status      String    @default("IN_PROGRESS") // "IN_PROGRESS", "VALIDATED", "FAILED"
  completedAt DateTime? // La date de fin (pour calculer la durée)

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id])

  quizScore   Float?   // Note du quiz (sur 100)
  examScore   Float?   // Note de l'examen final (sur 100)
  fieldGrade  Float? 
  finalGrade  Float?   // Note finale calculée (30% quiz + 70% exam)
  isValidated Boolean  @default(false) // Passe à true si la note finale est suffisant

  // Un utilisateur ne peut s'inscrire qu'une seule fois au même cours
  @@unique([userId, courseId]) 
}

// 5. Table de progression (Qui a terminé quelle leçon)
model LessonProgress {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  score       Float?

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  // Un utilisateur ne peut terminer une leçon qu'une seule fois
  @@unique([userId, lessonId])
}

// 6. Table des Questions (Pour les Quiz)
model Question {
  id            Int      @id @default(autoincrement())
  questionText  String
  options       String[] // Un tableau qui contiendra les choix (ex: ["A", "B", "C"])
  correctAnswer Int      // Le numéro de la bonne réponse (0 pour A, 1 pour B, etc.)

  lessonId      Int?
  lesson        Lesson?   @relation("LessonQuiz", fields: [lessonId], references: [id], onDelete: Cascade)

  // Si la question appartient à l'examen final du cours :
  courseId      Int?
  course        Course?  @relation("CourseExam", fields: [courseId], references: [id], onDelete: Cascade)
}

// 7. Table des Branches (Catégories)
model Category {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  imageUrl String?  @default("https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=800")
  courses Course[] // Une branche contient plusieurs formations
}